# Stellar Privacy Analytics Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_BASE_URL=http://localhost:3000/api
API_VERSION=v1

# Database Configuration (if using external database)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=stellar_privacy
# DB_USER=postgres
# DB_PASSWORD=password

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-here
ENCRYPTION_KEY=your-32-character-encryption-key-here
SESSION_SECRET=your-session-secret-here

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# External Services (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Webhook Configuration
# WEBHOOK_URL=https://your-webhook-endpoint.com/hooks
# WEBHOOK_SECRET=your-webhook-secret

# Compliance Framework Updates
AUTO_UPDATE_FRAMEWORKS=true
FRAMEWORK_UPDATE_INTERVAL=24h

# Assessment Configuration
MAX_CONCURRENT_ASSESSMENTS=10
ASSESSMENT_TIMEOUT=300s
DEFAULT_RETENTION_DAYS=365

# Feature Flags
ENABLE_ML_PREDICTION=false
ENABLE_REAL_TIME_COLLABORATION=false
ENABLE_ADVANCED_ANALYTICS=false

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Cache Configuration
CACHE_TTL=3600s
CACHE_MAX_SIZE=1000

# Monitoring and Analytics
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30s
